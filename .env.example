# پایگاه داده SQLite — مسیر فایل نسبت به ریشه پروژه
DATABASE_URL="file:./data/site.db"

# کلید امضای کوکی نشست. حتماً در سرور با یک مقدار تصادفی جایگزین شود:
#   openssl rand -base64 48
SESSION_SECRET="یک-کلید-تصادفی-طولانی-بگذارید"

# نشانی اصلی سایت، برای سئو و نقشه سایت
NEXT_PUBLIC_SITE_URL="https://example.ir"

# حساب مدیر اولیه که با `npm run seed` ساخته می‌شود
ADMIN_EMAIL="admin@example.ir"
ADMIN_PASSWORD="یک-رمز-قوی-بگذارید"
ADMIN_NAME="مدیر سایت"
