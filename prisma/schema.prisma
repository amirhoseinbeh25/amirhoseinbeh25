// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum LetterType {
  IN
  OUT
}

enum LetterStatus {
  REGISTERED
  REFERRED
  IN_PROGRESS
  CLOSED
}

enum ReferralStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum LeaveType {
  DAILY
  MISSION
  HOURLY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id           String      @id @default(cuid())
  fullName     String
  username     String      @unique
  passwordHash String
  role         Role        @default(EMPLOYEE)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  managerId    String?
  manager      User?       @relation("ManagerToEmployee", fields: [managerId], references: [id])
  subordinates User[]      @relation("ManagerToEmployee")
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  lettersCreated    Letter[]       @relation("LetterCreatedBy")
  referralsSent     Referral[]     @relation("ReferralFrom")
  referralsReceived Referral[]     @relation("ReferralTo")
  tasksAssigned     Task[]         @relation("TaskAssignedTo")
  tasksCreated      Task[]         @relation("TaskCreatedBy")
  leaveRequests     LeaveRequest[] @relation("LeaveRequester")
  leaveDecisions    LeaveRequest[] @relation("LeaveApprover")
  notifications     Notification[]
}

model Letter {
  id            String       @id @default(cuid())
  refNumber     String       @unique
  year          Int
  sequence      Int
  type          LetterType
  subject       String
  content       String?
  senderName    String?
  recipientName String?
  status        LetterStatus @default(REGISTERED)
  createdById   String
  createdBy     User         @relation("LetterCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  attachments Attachment[]
  referrals   Referral[]

  @@unique([year, sequence])
  @@index([type, status])
}

model Referral {
  id          String         @id @default(cuid())
  letterId    String
  letter      Letter         @relation(fields: [letterId], references: [id])
  fromUserId  String
  fromUser    User           @relation("ReferralFrom", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User           @relation("ReferralTo", fields: [toUserId], references: [id])
  instruction String
  status      ReferralStatus @default(PENDING)
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  respondedAt DateTime?

  task Task?

  @@index([toUserId, status])
}

model Task {
  id               String       @id @default(cuid())
  title            String
  description      String?
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(TODO)
  dueDate          DateTime?
  assignedToId     String
  assignedTo       User         @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdById      String
  createdBy        User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  sourceReferralId String?      @unique
  sourceReferral   Referral?    @relation(fields: [sourceReferralId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([assignedToId, status])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("LeaveRequester", fields: [userId], references: [id])
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       LeaveStatus @default(PENDING)
  approverId   String?
  approver     User?       @relation("LeaveApprover", fields: [approverId], references: [id])
  decisionNote String?
  createdAt    DateTime    @default(now())
  decidedAt    DateTime?

  @@index([userId, status])
  @@index([approverId, status])
}

model Attachment {
  id         String   @id @default(cuid())
  letterId   String
  letter     Letter   @relation(fields: [letterId], references: [id])
  fileName   String
  filePath   String
  mimeType   String
  size       Int
  uploadedAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}
